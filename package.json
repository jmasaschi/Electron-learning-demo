{
  "name": "electron-learning-demo",
  "version": "1.0.0",
  "description": "Learning to use electron and make a screen capture app",
  "homepage": "https://github.com/jmasaschi/Electron-learning-demo#readme",
  "bugs": {
    "url": "https://github.com/jmasaschi/Electron-learning-demo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmasaschi/Electron-learning-demo.git"
  },
  "license": "ISC",
  "author": "Jake Masaschi",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "nodemon --ext js,html,css --exec electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.jm.electron-learning-demo-SC",
    "productName": "Electron Learning Screen Capture app",
    "files": [
      "**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "identity": null
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.14"
  }
}
